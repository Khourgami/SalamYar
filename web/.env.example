# Base URL of the backend API. Always relative: Vite proxies /api in dev, nginx in the container.
VITE_API_BASE_URL=/api/v1

# When "true", MSW intercepts every /api/v1 request so the app works without the backend.
VITE_USE_MOCKS=true

# Dev-server only: where Vite proxies /api. Defaults to http://localhost:8000.
# Set this when the backend dev server runs on another port.
VITE_API_PROXY_TARGET=http://localhost:8000
